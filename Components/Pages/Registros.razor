@page "/registros"
@rendermode InteractiveServer

@inject RegistroDAO RegDAO;

<PageTitle>Registros - Sistema de Controle</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Consulta de Registros</h2>
        <p class="text-muted mb-0">Selecione o tipo de informação que deseja consultar.</p>
    </div>

    <div>
        <select class="form-select" @bind="tipoSelecionado">
            <option value="Clientes">Clientes</option>
            <option value="Produtos">Produtos</option>
            <option value="Vendas">Vendas</option>
            <option value="Entregadores">Entregadores</option>
            <option value="Fornecedores">Fornecedores</option>
        </select>
    </div>

</div>

<div class="custom-table-card">
    <div class="table-responsive">

        @if (tipoSelecionado == "Clientes")
        {
            <h4 class="fw-bold mb-3">Consulta de Clientes</h4>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Email</th>
                        <th>Telefone</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registro in registros)
                    {
                        @if (registro.Cliente != null)
                        {
                            <tr>
                                <td>@registro.Cliente.Id</td>
                                <td>@registro.Cliente.Nome</td>
                                <td>@registro.Cliente.Cpf</td>
                                <td>@registro.Cliente.Email</td>
                                <td>@registro.Cliente.Telefone</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        @if (tipoSelecionado == "Produtos")
        {
            <h4 class="fw-bold mb-3">Consulta de Produtos</h4>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Quantidade</th>
                        <th>Preço</th>
                        <th>Descrição</th>
                        <th>Fornecedor</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registro in registros)
                    {
                        @if (registro.Venda?.Produto != null)
                        {
                            <tr>
                                <td>@registro.Venda.Produto.Id</td>
                                <td>@registro.Venda.Produto.Nome</td>
                                <td>@registro.Venda.Produto.Quantidade</td>
                                <td>R$ @registro.Venda.Produto.Preco</td>
                                <td>@registro.Venda.Produto.Descricao</td>

                                <td>
                                    @if (registro.Venda.Produto.Fornecedor != null)
                                    {
                                        @registro.Venda.Produto.Fornecedor.Nome
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        @if (tipoSelecionado == "Vendas")
        {
            <h4 class="fw-bold mb-3">Consulta de Vendas</h4>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Data</th>
                        <th>Descrição</th>
                        <th>Cliente</th>
                        <th>Produto</th>
                        <th>Entregador</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registro in registros)
                    {
                        @if (registro.Venda != null)
                        {
                            <tr>
                                <td>@registro.Venda.Id</td>
                                <td>@registro.Venda.DataRegistro</td>
                                <td>@registro.Venda.Descricao</td>

                                <td>
                                    @if (registro.Venda.Cliente != null)
                                    {
                                        @registro.Venda.Cliente.Nome
                                    }
                                </td>

                                <td>
                                    @if (registro.Venda.Produto != null)
                                    {
                                        @registro.Venda.Produto.Nome
                                    }
                                </td>

                                <td>
                                    @if (registro.Venda.Entregador != null)
                                    {
                                        @registro.Venda.Entregador.Nome
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        @if (tipoSelecionado == "Entregadores")
        {
            <h4 class="fw-bold mb-3">Consulta de Entregadores</h4>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Telefone</th>
                        <th>CNH</th>
                        <th>Data Nascimento</th>
                        <th>Data Cadastro</th>
                        <th>Descrição</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registro in registros)
                    {
                        @if (registro.Entregador != null)
                        {
                            <tr>
                                <td>@registro.Entregador.Nome</td>
                                <td>@registro.Entregador.Telefone</td>
                                <td>@registro.Entregador.CNH</td>
                                <td>@registro.Entregador.DataNascimento.ToString("dd/MM/yyyy")</td>
                                <td>@registro.Entregador.DataCadastro.ToString("dd/MM/yyyy")</td>
                                <td>@registro.Entregador.Descricao</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        @if (tipoSelecionado == "Fornecedores")
        {
            <h4 class="fw-bold mb-3">Consulta de Fornecedores</h4>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CNPJ</th>
                        <th>Telefone</th>
                        <th>Email</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registro in registros)
                    {
                        @if (registro.Venda?.Produto?.Fornecedor != null)
                        {
                            <tr>
                                <td>@registro.Venda.Produto.Fornecedor.Id</td>
                                <td>@registro.Venda.Produto.Fornecedor.Nome</td>
                                <td>@registro.Venda.Produto.Fornecedor.Cnpj</td>
                                <td>@registro.Venda.Produto.Fornecedor.Telefone</td>
                                <td>@registro.Venda.Produto.Fornecedor.Email</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

    </div>
</div>

@code {

    private List<Registro> registros = new List<Registro>();

    private string tipoSelecionado = "Clientes";

    protected override void OnInitialized()
    {
        registros = RegDAO.Listar();
    }
}