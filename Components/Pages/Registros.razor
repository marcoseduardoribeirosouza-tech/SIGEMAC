@page "/registros"
@rendermode InteractiveServer
@inject CidadeDAO CidDAO;
@inject EstadoDAO EstDAO;
@inject EnderecoDAO EndDAO;
@inject ClienteDAO CliDAO;
@inject EntregadorDAO EntrDAo;
@inject FornecedorDAO FornDAO;
@inject ProdutoDAO ProDAO;
@inject VendaDAO VendDAO;
@inject RegistroDAO RegDAO;


<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>

</div>


<div calss="custom-table-card">
    <div class="table table-responsive">

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Interassando</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in registros)
                {
                    
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Cliente.Nome</td>

                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="#" class="btn btn-light border text-bg-danger-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

        <h2 class="fw-bold mb-1">Consulta de Fornecedores</h2>

        <div class="custom-table-card">
            <div class="table-responsive">

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CNPJ</th>
                            <th>Telefone</th>
                            <th>Email</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var f in fornecedores)
                        {
                            <tr>
                                <td>@f.Id</td>
                                <td>@f.Nome</td>
                                <td>@f.Cnpj</td>
                                <td>@f.Telefone</td>
                                <td>@f.Email</td>

                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="#" class="btn btn-light border text-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a href="#" class="btn btn-light border text-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

@code {
    
    private List<Cidade>? cidades;
    private List<Estado>? estados;
    private List<Endereco>? enderecos;
    private List<Cliente>? clientes;
    private List<Entregador>? entregadores;
    private List<Fornecedor>? fornecedores;
    private List<Produto>? produtos;
    private List<Venda>? vendas;
    private List<Registro>? registros;

    protected override void OnInitialized()
    {
        CarregarListas();
    }

    private void CarregarListas()
    {
        cidades = CidDAO.Listar();
        estados = EstDAO.Listar();
        enderecos = EndDAO.Listar();
        clientes = CliDAO.Listar();
        entregadores = EntrDAo.Listar();
        fornecedores = FornDAO.Listar();
        produtos = ProDAO.Listar();
        vendas = VendDAO.Listar();
        registros = RegDAO.Listar();
    }
}