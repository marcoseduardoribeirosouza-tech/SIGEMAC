@page "/estoque"
@rendermode InteractiveServer
@using sigemac.Models;

@inject ProdutoDAO ProDAO
@inject FornecedorDAO FornDao

<input type="checkbox" id="controle-modal" class="modal-hidden">

<div class="container">
    <div class="cabecalho">
        <h1>Estoque</h1>
    </div>

    <div>
    <a href="estoque/estoqueCadastro" class="btnCadastro btn-primary">+ Cadastrar Produto
    </a>
    </div>

    <div class="busca">
        <input type="text" placeholder="Buscar produtos...">
    </div>


    
    <div class="grid-produtos">
        @foreach (var produtos in produto)
        {
        <div class="card">
            <div class="card-texto">
                <span class="quantidade">@produtos.Quantidade</span>
                <h3>@produtos.Nome</h3>
                <span class="preco">R$ @produtos.Preco.ToString("C")</span>
            </div>
            <button class="botao-solicitar">Solicitar material</button>
        </div>
        }
    </div>
</div>

@code {
    private List<Produto>? produto = new();

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        produto = ProDAO.Listar();
    }
}

