@page "/vendas"

<PageTitle>Vendas</PageTitle>

<h1>Registro de Venda</h1>

<div class="formulario-venda">
	<div class="campo">
		<label>Item</label>
		<input type="text" placeholder="Selecione o item"/>
	</div>

	<div class="campo">
		<label>Entregador</label>
		<input type="text" placeholder="Nome do Entregador" />
	</div>

	<div class="campo">
		<label>Data de Registro</label>
		<input type="date" />
	</div>

	<div class="campo">
		<label>Cliente</label>
		<input type="text" placeholder="Colocar o Nome do Cliente"/>
	</div>

	<div class="campo"> 
		<label>Detalhes</label>
		<textarea placeholder="Informações adicionais do item"></textarea>
	</div>

	<div class="botoes">
		<button class="cancelar">Cancelar</button>
		<button class="salvar">Salvar</button>
	</div>

	@* Não há como fazer algo muito além disso por enquanto,
		preciso de pelo menos ter uma "lista" do item e cadastro 
		tanto de cliente como de entregador para começar a fazer do jeito certo o select como está no protótipo figma
	*@

</div>