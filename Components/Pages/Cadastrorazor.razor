@page "/cadastroCliente/cadastro"
@rendermode InteractiveServer

@inject ClienteDAO CliDAO
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Components.Forms
@using sigemac.Models

<PageTitle>Cadastrar Cliente</PageTitle>

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Cadastro de Cliente</h2>

            <p class="text-muted mb-0">
                Preencha os dados para cadastrar um novo cliente.
            </p>
        </div>
    </div>

    <div class="custom-table-card p-4">

        <EditForm Model="cliente" OnValidSubmit="Salvar">

            <DataAnnotationsValidator />

            <ValidationSummary class="alert alert-danger" />

            <!-- Nome -->
            <div class="row mb-3">

                <div class="col-md-8">

                    <label for="nome" class="form-label">
                        Nome
                    </label>

                    <InputText id="nome"
                               class="form-control"
                               @bind-Value="cliente.Nome"
                               placeholder="Digite o nome do cliente" />

                    <ValidationMessage For="() => cliente.Nome" />

                </div>

            </div>

            <!-- E-mail e Telefone -->
            <div class="row mb-3">

                <div class="col-md-6">

                    <label for="email" class="form-label">
                        E-mail
                    </label>

                    <InputText id="email"
                               type="email"
                               class="form-control"
                               @bind-Value="cliente.Email"
                               placeholder="Digite o e-mail" />

                    <ValidationMessage For="() => cliente.Email" />

                </div>

                <div class="col-md-6">

                    <label for="telefone" class="form-label">
                        Telefone
                    </label>

                    <InputText id="telefone"
                               class="form-control"
                               @bind-Value="cliente.Telefone"
                               placeholder="Digite o telefone" />

                    <ValidationMessage For="() => cliente.Telefone" />

                </div>

            </div>

            <!-- CPF -->
            <div class="row mb-3">

                <div class="col-md-6">

                    <label for="cpf" class="form-label">
                        CPF
                    </label>

                    <InputText id="cpf"
                               class="form-control"
                               @bind-Value="cliente.Cpf"
                               placeholder="000.000.000-00" />

                    <ValidationMessage For="() => cliente.Cpf" />

                </div>

            </div>

            <!-- Observação -->
            <div class="row mb-3">

                <div class="col-md-12">

                    <label for="observacao" class="form-label">
                        Observação
                    </label>

                    <InputTextArea id="observacao"
                                   class="form-control"
                                   rows="4"
                                   @bind-Value="cliente.Observacao"
                                   placeholder="Digite alguma observação sobre o cliente" />

                    <ValidationMessage For="() => cliente.Observacao" />

                </div>

            </div>

            <!-- Botões -->
            <div class="d-flex gap-2 mt-4">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Salvar
                </button>

                <a href="/cadastroCliente" class="btn btn-light border">
                    Cancelar
                </a>

            </div>

        </EditForm>

    </div>

</div>

@code {

    private Cliente cliente = new();

    private void Salvar()
    {
        CliDAO.Inserir(cliente);

        NavigationManager.NavigateTo("/cadastroCliente");
    }
}
