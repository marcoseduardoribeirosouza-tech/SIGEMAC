@page "/estoque/estoqueCadastro"
@rendermode InteractiveServer

@inject ProdutoDAO Prodao
@inject NavigationManager NavigationManager

@using sigemac.Models;

<PageTitle>Cadastro de Produto</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Processo</h2>
    </div>
</div>

<div class="custom-table-card p-4">
    <EditForm Model="produto" OnValidSubmit="Salvar">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">
            <div class="col-md-4">
                <label for="nome_prod" class="form-label">
                    Nome do Produto
                </label>
                <InputText id="nome_prod"
                           class="form-control"
                           @bind-Value="produto.Nome" />
                <ValidationMessage For="() => produto.Nome" />
            </div>

            <div class="col-md-4">
                <label for="quantidade_prod" class="form-label">
                    Quantidade de Produto
                </label>
                <InputNumber id="quantidade_prod"
                             class="form-control"
                             @bind-Value="produto.Quantidade" />
                <ValidationMessage For="() => produto.Quantidade" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label for="preco_prod" class="form-label">
                    Preço
                </label>
                <InputNumber id="preco_prod"
                             class="form-control"
                             @bind-Value="produto.Preco" />
                <ValidationMessage For="() => produto.Preco" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label for="descricao_prod" class="form-label">
                    Descrição
                </label>
                <InputText id="descricao"
                           class="form-control"
                           @bind-Value="produto.Descricao" />
                <ValidationMessage For="() => produto.Descricao" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Salvar
            </button>
            <a href="/estoque" class="btn btn-light border">
                Cancelar
            </a>
        </div>
    </EditForm>
</div>

@code {
    private Produto produto = new();

    private void Salvar()
    {
        Prodao.Inserir(produto);
        NavigationManager.NavigateTo("/estoque");
    }
}