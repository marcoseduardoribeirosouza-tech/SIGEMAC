@page "/configuracoes"

<PageTitle>Configurações</PageTitle>

<div class="pagina-total">
    <h1>Configurações</h1>
    <div class="big-card">
        <h2>DATA E HORA</h2>
        <div class="cards">
            <div class="mini-card">
                <h3>Formato de Data</h3>
                <div class="dropdown">
                    <button class="dropbtn">DD-MM-YYYY</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">DD-MM-YYYY</button>
                        <button class="nenhuma">MM-DD-YYYY</button>
                        <button class="nenhuma">YYYY-DD-MM</button>
                        <button class="nenhuma">YYYY-MM-DD</button>
                    </div>
                </div>
            </div>
            <div class="mini-card">
                <h3>Formato de Hora</h3>
                <div class="dropdown">
                    <button class="dropbtn">Hora AM/PM</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">Hora AM/PMs</button>
                        <button class="nenhuma">Hora Militar</button>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
    <div class="big-card">
        <h2>UNIDADE MONETÁRIA</h2>
        <div class="cards">
            <div class="mini-card">
                <h3>Moeda Padrão</h3>
                <div class="dropdown">
                    <button class="dropbtn">R$ Real (BRL)</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">R$ Real (BRL)</button>
                        <button class="nenhuma">$ Dólar (USD)</button>
                        <button class="nenhuma">€ Euro (EUR)</button>
                    </div>
                </div>
        </div>
        </div>
    </div>

    <div class="big-card">
        <h2>BACKUP</h2>
        <div class="cards">
            <div class="mini-card">
                <h3>Backup Automático</h3>
                <div class="dropdown">
                    <button class="dropbtn">Ativado</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">Ativado</button>
                        <button class="nenhuma">Desativado</button>
                    </div>
                </div>
            </div>

            <div class="mini-card">
                <h3>Frequência do Backup</h3>
                <div class="dropdown">
                    <button class="dropbtn">Diário</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">Diário</button>
                        <button class="nenhuma">Semanal</button>
                        <button class="nenhuma">Mensal</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="big-card">
        <h2>CONFIRMAÇÕES</h2>
        <div class="cards">
            <div class="mini-card">
                <h3>Confirmar Exclusão</h3>
                <div class="dropdown">
                    <button class="dropbtn">Ativado</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">Ativado</button>
                        <button class="nenhuma">Desativado</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="big-card">
        <h2>ESTOQUE</h2>
        <div class="cards">
            <div class="mini-card">
                <h3>Itens por Página</h3>
                <div class="dropdown">
                    <button class="dropbtn">20</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">10</button>
                        <button class="nenhuma">20</button>
                        <button class="nenhuma">50</button>
                        <button class="nenhuma">100</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>