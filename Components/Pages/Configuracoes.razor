@page "/configuracoes"

<PageTitle>Configurações</PageTitle>

<div class="pagina-total">
    <h1>CONFIGURAÇÕES</h1>
    <div class="data-e-hora">
        <h2>Data e Hora</h2>
        <div class="cards">
            <div class="card-data">
                <h3>Formato de Data</h3>
                <div class="dropdown">
                    <button class="dropbtn">DD-MM-YYYY</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">DD-MM-YYYY</button>
                        <button class="nenhuma">MM-DD-YYYY</button>
                        <button class="nenhuma">YYYY-DD-MM</button>
                        <button class="nenhuma">YYYY-MM-DD</button>
                    </div>
                </div>
            </div>
            <div class="card-hora">
                <h3>Formato de Hora</h3>
                <div class="dropdown">
                    <button class="dropbtn">Hora AM/PM</button>
                    <div class="dropdown-content">
                        <button class="nenhuma">Hora AM/PMs</button>
                        <button class="nenhuma">Hora Militars</button>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
    <div class="unidade-monetaria">
        <h2>Unidade Monetária</h2>
        <div class="card-unidade-monetaria">

        </div>
    </div>
    <div class="backup">
        <h2>Backup</h2>
        <div class="card-backup">

        </div>
        <div class="card-frequencia-backup">

        </div>
    </div>
    <div class="confirmacoes">
        <h2>Confirmações</h2>
        <div class="card-confirmar-delete">

        </div>
    </div>
    <div class="configuracoes-de-estoque">
        <h2>Estoque</h2>
        <div class="card-itens-por-fileira">

        </div>

   </div>
</div>