@page "/cadastros"
@rendermode InteractiveServer
@inject CidadeDAO CidDAO;
@inject EstadoDAO EstDAO;
@inject EnderecoDAO EndDAO;
@inject ClienteDAO CliDAO;
@inject EntregadorDAO EntrDAo;
@inject FornecedorDAO FornDAO;
@inject ProdutoDAO ProDAO;
@inject VendaDAO VendDAO;
@inject RegistroDAO RegDAO;


<PageTitle>Cadastros</PageTitle>

<div class="container">

	<h1> Cadastros </h1>

	<div class="area">
		<div class="clientes">

			<div class="cabecalho">
				<h2> Clientes </h2>
				<label class="cadastrar-cliente">Cadastrar Cliente</label>
			</div>

			<div class="lista">

				<h5> Clientes Cadastrados </h5>

				<div class="cliente">
					<h6> ID: 1 - Cliente: João Silva </h6>
					<p> telefone: 0002-4531 - cpf: 000.000.000-22 </p>
				</div>

				<div class="cliente">
					<h6> ID: 2 - Cliente: Miguel Tavares </h6>
					<p> telefone: 0002-5465 - cpf: 000.000.000-33 </p>
				</div>

				<div class="cliente">
					<h6> ID: 1 - Cliente: kalebe Santos </h6>
					<p> telefone: 0002-3579 - cpf: 000.000.000-44 </p>
				</div>
			</div>
		</div>
	</div>
</div>
<div calss="custom-table-card">
</div>

@code {

	private List<Cidade>? cidades;
	private List<Estado>? estados;
	private List<Endereco>? enderecos;
	private List<Cliente>? clientes;
	private List<Entregador>? entregadores;
	private List<Fornecedor>? fornecedores;
	private List<Produto>? produtos;
	private List<Venda>? vendas;
	private List<Registro>? registros;

	protected override void OnInitialized()
	{
		CarregarListas();
	}

	private void CarregarListas()
	{
		cidades = CidDAO.Listar();
		estados = EstDAO.Listar();
		enderecos = EndDAO.Listar();
		clientes = CliDAO.Listar();
		entregadores = EntrDAo.Listar();
		fornecedores = FornDAO.Listar();
		produtos = ProDAO.Listar();
		vendas = VendDAO.Listar();
		registros = RegDAO.Listar();
	}
}



